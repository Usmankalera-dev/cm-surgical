# ---------------------------------------------------------------------------
# CM SURGICAL — site configuration
# Copy this file to  .env  and fill in real values:   cp .env.example .env
# Then start the site with:   ./start.sh
# ---------------------------------------------------------------------------

# REQUIRED before going live. Any long random string.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-something-random-and-long

# REQUIRED before going live. The admin panel login password.
ADMIN_PASSWORD=change-this-password

# Set to "production" once the values above are real. The site then REFUSES to
# start if SECRET_KEY or ADMIN_PASSWORD are still left at their defaults.
APP_ENV=production

# Address that receives the one-time admin login codes.
ADMIN_LOGIN_EMAIL=admin@cmsurgical.pk

# How long a one-time code stays valid, and how many can be requested per hour.
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_PER_HOUR=5

# Set to 1 ONLY while demonstrating on your OWN machine, so the one-time code is
# shown on screen. NEVER set this while the site is reachable on the internet —
# anyone could request a code, read it off the screen, and sign in.
# LOGIN_CODE_DEMO=1

# Port the site listens on.
PORT=8000

# Set to 1 ONLY while you are actively developing. Never on a live site.
FLASK_DEBUG=0
